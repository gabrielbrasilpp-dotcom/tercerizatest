generator client { 
  provider = "prisma-client-js" 
} 
 
datasource db { 
  provider = "postgresql" 
  url      = env("DATABASE_URL") 
} 
 
model User { 
  id        String    @id @default(uuid()) 
  name      String 
  email     String    @unique 
  password  String 
  createdAt DateTime  @default(now()) 
  services  Service[] 
} 
 
model Service { 
  id          String   @id @default(uuid()) 
  title       String 
  description String 
  price       Float 
  createdAt   DateTime @default(now()) 
  userId      String 
  user        User     @relation(fields: [userId], references: [id]) 
}
