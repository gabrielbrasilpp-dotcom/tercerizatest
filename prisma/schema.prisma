generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("CLIENT")
  phone     String?
  city      String   @default("Ponta Porã - MS")
  createdAt DateTime @default(now())

  services  Service[]
  orders    Order[]
  proposals Proposal[]
  messages  Message[]
}

model Service {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String
  priceFrom   Float?
  city        String   @default("Ponta Porã - MS")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Order {
  id          String     @id @default(uuid())
  title       String
  category    String
  description String
  city        String     @default("Ponta Porã - MS")
  urgency     String     @default("Media")
  budgetRange String     @default("A combinar")
  deadline    String?
  status      String     @default("OPEN")
  clientId    String
  client      User       @relation(fields: [clientId], references: [id])
  proposals   Proposal[]
  createdAt   DateTime   @default(now())
}

model Proposal {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  professionalId String
  professional   User      @relation(fields: [professionalId], references: [id])
  price          Float
  status         String    @default("PENDING")
  messages       Message[]
  createdAt      DateTime  @default(now())
}

model Message {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  text       String
  createdAt  DateTime @default(now())
}
